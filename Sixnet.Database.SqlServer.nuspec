    <tags>.NET,Sixnet,SQL Serever</tags>
    <dependencies>
        <dependency id="Microsoft.Data.SqlClient" version="7.0.1" />
        <dependency id="Sixnet" version="3.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="Sixnet.Database.SqlServer\bin\$configuration$\net6.0\Sixnet.Database.SqlServer.dll" target="lib\net6.0" />
